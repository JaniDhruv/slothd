# ==============================================================================
# slothd — Configuration & Environment Template
# Copy this file to .env and customize for your local setup.
# ==============================================================================

# Ollama local inference host and models
SLOTHD_OLLAMA_HOST=http://localhost:11434
SLOTHD_OLLAMA_MODEL=gemma3
SLOTHD_EMBED_MODEL=nomic-embed-text

# Tiger Data (PostgreSQL + pgvector) connection string
# Local docker example: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=slothd -e POSTGRES_USER=slothd -e POSTGRES_DB=slothd timescale/timescaledb-ha:pg17
SLOTHD_DB_URL=postgresql://slothd:slothd@localhost:5432/slothd

# Target directories to monitor (comma-separated, default is ~/Downloads)
# SLOTHD_TARGET_DIRS=/path/to/Downloads

# Optional base directory for organized files (if unset, organizes in-place)
# SLOTHD_OUTPUT_DIR=/path/to/Organized

# SerpApi API Key (Optional: only used when --enrich-online flag is passed)
SERPAPI_KEY=

# Sentry DSN (Optional: for distributed agent tracing waterfall views)
SENTRY_DSN=

# ElevenLabs Text-to-Speech (Optional: generates voice summaries)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
